{
  "name": "forsyde-playground",
  "version": "1.4.0",
  "description": "Browser editor for ForSyDe Shallow SDF models: live diagrams, schedule, analysis and token animation",
  "scripts": {
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:remote": "PW_REMOTE=1 playwright test",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "format": "prettier --write ."
  },
  "homepage": "https://ramadhanafif.github.io/ForSyDe-Diagram-Web/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramadhanafif/ForSyDe-Diagram-Web.git"
  },
  "bugs": "https://github.com/ramadhanafif/ForSyDe-Diagram-Web/issues",
  "keywords": [
    "forsyde",
    "sdf",
    "dataflow",
    "haskell"
  ],
  "author": "Muhammad Afif Ramadhan",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
